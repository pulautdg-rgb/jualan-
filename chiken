// 3. MENU CATALOG & ITEM CARDS
function MenuCatalog({ items, onAddToCart }) {
  const [selectedCategory, setSelectedCategory] = useState('Semua');
  const [selectedFillings, setSelectedFillings] = useState({});
  const [selectedVariants, setSelectedVariants] = useState({});

  const categories = ['Semua', 'Cireng Crispy', 'Cireng Isi', 'Jajanan Kuah', 'Minuman'];

  const filteredItems = selectedCategory === 'Semua' 
    ? items 
    : items.filter(item => item.category === selectedCategory);

  const handleVariantSelect = (itemId, variant) => {
    setSelectedVariants(prev => ({ ...prev, [itemId]: variant }));
  };

  const handleFillingSelect = (itemId, filling) => {
    setSelectedFillings(prev => ({ ...prev, [itemId]: filling }));
  };

  return (
    <section id="katalog-menu" className="space-y-6">
      <div className="flex items-center justify-between border-b border-slate-200 pb-4">
        <div>
          <h2 className="text-2xl font-black text-slate-900">Katalog Menu</h2>
          <p className="text-xs text-slate-500">Pilih varian rasa & isian favoritmu</p>
        </div>
      </div>

      {/* Category Tabs */}
      <div className="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
        {categories.map((cat) => (
          <button
            key={cat}
            onClick={() => setSelectedCategory(cat)}
            className={`px-4 py-2 rounded-xl text-xs font-extrabold whitespace-nowrap transition-all cursor-pointer ${
              selectedCategory === cat
                ? 'bg-red-600 text-white shadow-md shadow-red-200'
                : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      {/* Menu Cards Grid */}
      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {filteredItems.map((item) => {
          const currentVariant = selectedVariants[item.id] || 'reguler';
          const currentFilling = selectedFillings[item.id] || (item.availableFillings ? item.availableFillings[0] : '');

          const price = currentVariant === 'filling' && item.fillingPrice 
            ? item.fillingPrice 
            : item.regulerPrice || item.basePrice;

          return (
            <div 
              key={item.id}
              className={`bg-white rounded-2xl border ${item.inStock ? 'border-slate-200' : 'border-slate-100 opacity-60'} p-4 flex flex-col justify-between shadow-xs hover:shadow-md transition`}
            >
              <div>
                <div className="relative h-40 -mx-4 -mt-4 mb-3 overflow-hidden rounded-t-2xl bg-slate-100">
                  <img 
                    src={item.image} 
                    alt={item.name} 
                    className="w-full h-full object-cover"
                  />
                  {item.isBestSeller && (
                    <span className="absolute top-3 left-3 bg-amber-400 text-slate-900 font-black text-[10px] px-2.5 py-1 rounded-full uppercase shadow-xs flex items-center gap-1">
                      <Award className="w-3 h-3" /> Best Seller
                    </span>
                  )}
                  {!item.inStock && (
                    <div className="absolute inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center text-white font-extrabold text-sm uppercase">
                      Stok Habis
                    </div>
                  )}
                </div>

                <h3 className="font-bold text-slate-900 text-base">{item.name}</h3>
                <p className="text-xs text-slate-500 mt-1 line-clamp-2">{item.description}</p>

                {/* Variant Selector Options if available */}
                {item.availableFillings && item.availableFillings.length > 0 && (
                  <div className="mt-3 space-y-2 bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                    <div className="flex gap-2 text-xs font-bold">
                      <button
                        onClick={() => handleVariantSelect(item.id, 'reguler')}
                        className={`flex-1 py-1 rounded-lg border text-[11px] cursor-pointer ${
                          currentVariant === 'reguler'
                            ? 'bg-red-600 text-white border-red-600'
                            : 'bg-white text-slate-700 border-slate-200'
                        }`}
                      >
                        Reguler (Rp {item.regulerPrice.toLocaleString('id-ID')})
                      </button>
                      <button
                        onClick={() => handleVariantSelect(item.id, 'filling')}
                        className={`flex-1 py-1 rounded-lg border text-[11px] cursor-pointer ${
                          currentVariant === 'filling'
                            ? 'bg-red-600 text-white border-red-600'
                            : 'bg-white text-slate-700 border-slate-200'
                        }`}
                      >
                        Extra Isian (+Rp {(item.fillingPrice - item.regulerPrice).toLocaleString('id-ID')})
                      </button>
                    </div>

                    <div className="space-y-1">
                      <label className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                        Pilihan Varian/Isian:
                      </label>
                      <select
                        value={currentFilling}
                        onChange={(e) => handleFillingSelect(item.id, e.target.value)}
                        className="w-full text-xs font-semibold p-1.5 rounded-lg border border-slate-200 bg-white text-slate-800"
                      >
                        {item.availableFillings.map((f) => (
                          <option key={f} value={f}>{f}</option>
                        ))}
                      </select>
                    </div>
                  </div>
                )}
              </div>

              <div className="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                <div>
                  <span className="text-[10px] text-slate-400 font-bold block">HARGA</span>
                  <span className="font-black text-red-600 text-lg">
                    Rp {price.toLocaleString('id-ID')}
                  </span>
                </div>

                <button
                  disabled={!item.inStock}
                  onClick={() => onAddToCart(item, currentVariant, item.availableFillings ? currentFilling : undefined)}
                  className="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs shadow-md shadow-red-200 active:scale-95 transition disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1.5 cursor-pointer"
                >
                  <Plus className="w-4 h-4" /> Tambah
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  );
}

// 4. CART & CHECKOUT
function CartCheckout({ cart, customerData, onUpdateCustomerData, onUpdateQuantity, onRemoveItem, onClearCart, onCreateOrder }) {
  const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

  const handleSubmitOrder = (e) => {
    e.preventDefault();
    if (cart.length === 0) return;
    if (!customerData.name || !customerData.whatsapp) {
      alert('Mohon isi nama dan nomor WhatsApp kamu terlebih dahulu.');
      return;
    }

    const randomNum = Math.floor(1000 + Math.random() * 9000);
    const newOrder = {
      id: `ORD-${randomNum}`,
      orderNumber: `CR-${randomNum}`,
      customer: customerData,
      items: cart,
      totalAmount: subtotal,
      status: 'Menunggu Konfirmasi',
      createdAt: new Date().toISOString(),
      isNew: true
    };

    onCreateOrder(newOrder);
  };

  return (
    <div className="bg-white rounded-3xl border border-slate-200 p-5 shadow-sm space-y-5 sticky top-20">
      <div className="flex items-center justify-between border-b border-slate-100 pb-3">
        <h3 className="font-extrabold text-lg text-slate-900 flex items-center gap-2">
          <ShoppingBag className="w-5 h-5 text-red-600" /> Keranjang Pesanan
        </h3>
        {cart.length > 0 && (
          <button 
            onClick={onClearCart}
            className="text-xs text-red-500 font-bold hover:underline flex items-center gap-1 cursor-pointer"
          >
            <Trash2 className="w-3.5 h-3.5" /> Bersihkan
          </button>
        )}
      </div>

      {cart.length === 0 ? (
        <div className="py-8 text-center space-y-2">
          <ShoppingBag className="w-12 h-12 text-slate-300 mx-auto" />
          <p className="text-sm font-bold text-slate-400">Keranjang masih kosong</p>
          <p className="text-xs text-slate-400">Pilih menu cireng favoritmu di samping</p>
        </div>
      ) : (
        <>
          {/* Cart Item List */}
          <div className="space-y-3 max-h-60 overflow-y-auto pr-1">
            {cart.map((item) => (
              <div key={item.cartItemId} className="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                <div className="flex-1 pr-2">
                  <p className="font-bold text-xs text-slate-800">{item.menuItem.name}</p>
                  <p className="text-[10px] text-slate-500">
                    {item.variant === 'filling' ? 'Extra Isian' : 'Reguler'} 
                    {item.selectedFilling ? ` • ${item.selectedFilling}` : ''}
                  </p>
                  <p className="font-black text-xs text-red-600 mt-0.5">
                    Rp {(item.price * item.quantity).toLocaleString('id-ID')}
                  </p>
                </div>

                <div className="flex items-center gap-2">
                  <button
                    onClick={() => onUpdateQuantity(item.cartItemId, -1)}
                    className="w-6 h-6 rounded-lg bg-white border border-slate-200 text-slate-700 font-bold flex items-center justify-center hover:bg-slate-100 cursor-pointer"
                  >
                    -
                  </button>
                  <span className="text-xs font-extrabold w-4 text-center">{item.quantity}</span>
                  <button
                    onClick={() => onUpdateQuantity(item.cartItemId, 1)}
                    className="w-6 h-6 rounded-lg bg-white border border-slate-200 text-slate-700 font-bold flex items-center justify-center hover:bg-slate-100 cursor-pointer"
                  >
                    +
                  </button>
                  <button
                    onClick={() => onRemoveItem(item.cartItemId)}
                    className="text-slate-400 hover:text-red-500 ml-1 cursor-pointer"
                  >
                    <X className="w-4 h-4" />
                  </button>
                </div>
              </div>
            ))}
          </div>

          <div className="border-t border-slate-100 pt-3 space-y-2">
            <div className="flex justify-between text-xs text-slate-500">
              <span>Subtotal Menu</span>
              <span>Rp {subtotal.toLocaleString('id-ID')}</span>
            </div>
            <div className="flex justify-between font-black text-base text-slate-900 pt-1 border-t border-dashed">
              <span>Total Bayar</span>
              <span className="text-red-600">Rp {subtotal.toLocaleString('id-ID')}</span>
            </div>
          </div>

          {/* Form Pemesanan */}
          <form onSubmit={handleSubmitOrder} className="space-y-3 pt-2 border-t border-slate-100">
            <h4 className="text-xs font-extrabold text-slate-900 uppercase tracking-wider">Data Pemesan</h4>
            <input
              type="text"
              placeholder="Nama Lengkap *"
              value={customerData.name}
              onChange={(e) => onUpdateCustomerData({ name: e.target.value })}
              required
              className="w-full text-xs p-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-red-500"
            />
            <input
              type="tel"
              placeholder="Nomor WhatsApp / HP *"
              value={customerData.whatsapp}
              onChange={(e) => onUpdateCustomerData({ whatsapp: e.target.value })}
              required
              className="w-full text-xs p-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-red-500"
            />
            <textarea
              placeholder="Catatan Khusus (Opsional)"
              value={customerData.notes}
              onChange={(e) => onUpdateCustomerData({ notes: e.target.value })}
              rows={2}
              className="w-full text-xs p-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-red-500"
            />

            <button
              type="submit"
              className="w-full py-3 bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs rounded-2xl shadow-lg shadow-red-200 transition active:scale-98 cursor-pointer"
            >
              Buat Pesanan Langsung
            </button>
          </form>
        </>
      )}
    </div>
  );
}

