// ==========================================
// MAIN APP COMPONENT
// ==========================================
export default function App() {
  const [currentMode, setCurrentMode] = useState('buyer');
  const [menuItems, setMenuItems] = useState(MENU_ITEMS);
  const [cart, setCart] = useState([]);
  
  const [orders, setOrders] = useState(() => {
    try {
      const saved = localStorage.getItem('cr_orders_v2');
      if (saved) return JSON.parse(saved);
    } catch (e) {
      console.error(e);
    }
    return INITIAL_ORDERS;
  });

  const [customerData, setCustomerData] = useState({
    name: '',
    whatsapp: '',
    address: '',
    notes: '',
  });

  const [isDirectionsOpen, setIsDirectionsOpen] = useState(false);
  const [isTrackerOpen, setIsTrackerOpen] = useState(false);
  const [isMobileCartOpen, setIsMobileCartOpen] = useState(false);
  const [confirmedOrder, setConfirmedOrder] = useState(null);
  const [isConfirmationOpen, setIsConfirmationOpen] = useState(false);
  const [trackerSearchTerm, setTrackerSearchTerm] = useState('');

  useEffect(() => {
    try {
      localStorage.setItem('cr_orders_v2', JSON.stringify(orders));
    } catch (e) {
      console.error(e);
    }
  }, [orders]);

  const handleAddToCart = (item, variant, selectedFilling) => {
    const price = variant === 'filling' ? item.fillingPrice || item.basePrice : item.regulerPrice || item.basePrice;
    const cartItemId = `${item.id}-${variant}-${selectedFilling || 'none'}`;

    setCart((prevCart) => {
      const existing = prevCart.find((ci) => ci.cartItemId === cartItemId);
      if (existing) {
        return prevCart.map((ci) =>
          ci.cartItemId === cartItemId ? { ...ci, quantity: ci.quantity + 1 } : ci
        );
      }
      return [
        ...prevCart,
        { cartItemId, menuItem: item, variant, selectedFilling, price, quantity: 1 }
      ];
    });
  };

  const handleUpdateQuantity = (cartItemId, delta) => {
    setCart((prevCart) =>
      prevCart
        .map((ci) => {
          if (ci.cartItemId === cartItemId) {
            const newQty = ci.quantity + delta;
            return newQty > 0 ? { ...ci, quantity: newQty } : null;
          }
          return ci;
        })
        .filter(Boolean)
    );
  };

  const handleRemoveItem = (cartItemId) => {
    setCart((prevCart) => prevCart.filter((ci) => ci.cartItemId !== cartItemId));
  };

  const handleClearCart = () => setCart([]);

  const handleUpdateCustomerData = (data) => setCustomerData((prev) => ({ ...prev, ...data }));

  const handleCreateOrder = (newOrder) => {
    setOrders((prev) => [newOrder, ...prev]);
    setCart([]);
    setConfirmedOrder(newOrder);
    setIsConfirmationOpen(true);
  };

  const handleUpdateOrderStatus = (orderId, newStatus) => {
    setOrders((prev) =>
      prev.map((ord) => (ord.id === orderId ? { ...ord, status: newStatus, isNew: false } : ord))
    );
  };

  const handleToggleStock = (menuId) => {
    setMenuItems((prev) =>
      prev.map((item) => (item.id === menuId ? { ...item, inStock: !item.inStock } : item))
    );
  };

  const handleScrollToMenu = () => {
    if (currentMode !== 'buyer') setCurrentMode('buyer');
    setTimeout(() => {
      const el = document.getElementById('katalog-menu');
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    }, 60);
  };

  const newOrdersCount = orders.filter((o) => o.status === 'Menunggu Konfirmasi').length;
  const activeOrderCount = orders.filter((o) => o.status !== 'Selesai' && o.status !== 'Dibatalkan').length;
  const totalCartCount = cart.reduce((sum, item) => sum + item.quantity, 0);
  const totalCartSubtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

  return (
    <div className="min-h-screen bg-[#fcf9f8] text-[#1b1b1c] flex flex-col font-sans selection:bg-red-200 selection:text-red-900">
      <Header
        currentMode={currentMode}
        onSelectMode={setCurrentMode}
        activeOrderCount={activeOrderCount}
        newOrdersCount={newOrdersCount}
        onOpenLocation={() => setIsDirectionsOpen(true)}
        onScrollToMenu={handleScrollToMenu}
      />

      <main className="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full space-y-8">
        {currentMode === 'buyer' ? (
          <>
            <HeroBanner
              onExploreMenu={handleScrollToMenu}
              onOpenLocation={() => setIsDirectionsOpen(true)}
            />

            <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
              <div className="lg:col-span-7 xl:col-span-8">
                <MenuCatalog items={menuItems} onAddToCart={handleAddToCart} />
              </div>

              <div className="hidden lg:block lg:col-span-5 xl:col-span-4">
                <CartCheckout
                  cart={cart}
                  customerData={customerData}
                  onUpdateCustomerData={handleUpdateCustomerData}
                  onUpdateQuantity={handleUpdateQuantity}
                  onRemoveItem={handleRemoveItem}
                  onClearCart={handleClearCart}
                  onCreateOrder={handleCreateOrder}
                />
              </div>
            </div>

            <OutletInfo onOpenDirections={() => setIsDirectionsOpen(true)} />
          </>
        ) : (
          <MerchantDashboard
            orders={orders}
            menuItems={menuItems}
            onUpdateOrderStatus={handleUpdateOrderStatus}
            onToggleStock={handleToggleStock}
            onReturnToBuyerMode={() => setCurrentMode('buyer')}
          />
        )}
      </main>

      {currentMode === 'buyer' && totalCartCount > 0 && (
        <div className="lg:hidden fixed bottom-4 inset-x-4 z-40">
          <button
            onClick={() => setIsMobileCartOpen(true)}
            className="w-full bg-red-600 hover:bg-red-700 text-white p-3.5 rounded-2xl shadow-xl flex items-center justify-between font-extrabold text-sm cursor-pointer"
          >
            <div className="flex items-center gap-2">
              <span className="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center text-xs">
                {totalCartCount}
              </span>
              <span>Buka Keranjang Pesanan</span>
            </div>
            <span>Rp {totalCartSubtotal.toLocaleString('id-ID')} &rarr;</span>
          </button>
        </div>
      )}

      {isMobileCartOpen && (
        <div className="lg:hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex flex-col justify-end">
          <div className="bg-white rounded-t-3xl max-h-[90vh] overflow-y-auto p-4 relative">
            <button
              onClick={() => setIsMobileCartOpen(false)}
              className="absolute top-4 right-4 w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 cursor-pointer"
            >
              <X className="w-5 h-5" />
            </button>
            <div className="pt-2">
              <CartCheckout
                cart={cart}
                customerData={customerData}
                onUpdateCustomerData={handleUpdateCustomerData}
                onUpdateQuantity={handleUpdateQuantity}
                onRemoveItem={handleRemoveItem}
                onClearCart={handleClearCart}
                onCreateOrder={(order) => {
                  handleCreateOrder(order);
                  setIsMobileCartOpen(false);
                }}
              />
            </div>
          </div>
        </div>
      )}

      <Footer
        onOpenLocation={() => setIsDirectionsOpen(true)}
        onSelectMode={setCurrentMode}
        onOpenOrderTracker={() => {
          setTrackerSearchTerm('');
          setIsTrackerOpen(true);
        }}
      />

      <OrderConfirmationModal
        isOpen={isConfirmationOpen}
        order={confirmedOrder}
        onClose={() => {
          setIsConfirmationOpen(false);
          handleScrollToMenu();
        }}
        onViewMyOrder={(order) => {
          setIsConfirmationOpen(false);
          setTrackerSearchTerm(order.orderNumber);
          setIsTrackerOpen(true);
        }}
      />

      <DirectionsModal
        isOpen={isDirectionsOpen}
        onClose={() => setIsDirectionsOpen(false)}
      />

      <OrderTrackerModal
        isOpen={isTrackerOpen}
        onClose={() => setIsTrackerOpen(false)}
        orders={orders}
        initialSearchTerm={trackerSearchTerm}
      />
    </div>
  );
}
