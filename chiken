                  </div>
                  <div className="flex items-center gap-2">
                    <span className="text-xs font-extrabold text-slate-500">Status:</span>
                    <select
                      value={order.status}
                      onChange={(e) => onUpdateOrderStatus(order.id, e.target.value)}
                      className="text-xs font-bold p-1.5 rounded-lg border border-slate-200 bg-slate-50 text-slate-800 cursor-pointer"
                    >
                      {statusList.map((st) => (
                        <option key={st} value={st}>{st}</option>
                      ))}
                    </select>
                  </div>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                  <div>
                    <p className="font-extrabold text-slate-700">Pelanggan:</p>
                    <p className="text-slate-900 font-bold">{order.customer.name} ({order.customer.whatsapp})</p>
                    {order.customer.notes && (
                      <p className="text-slate-500 italic mt-1 bg-amber-50 p-2 rounded-lg border border-amber-100">
                        "{order.customer.notes}"
                      </p>
                    )}
                  </div>

                  <div>
                    <p className="font-extrabold text-slate-700">Detail Menu:</p>
                    <ul className="space-y-1 mt-1">
                      {order.items.map((it, idx) => (
                        <li key={idx} className="text-slate-800 flex justify-between">
                          <span>
                            {it.quantity}x {it.menuItem.name} {it.selectedFilling ? `(${it.selectedFilling})` : ''}
                          </span>
                          <span className="font-bold">Rp {(it.price * it.quantity).toLocaleString('id-ID')}</span>
                        </li>
                      ))}
                    </ul>
                    <div className="mt-2 pt-2 border-t border-slate-100 font-black text-sm flex justify-between text-red-600">
                      <span>Total:</span>
                      <span>Rp {order.totalAmount.toLocaleString('id-ID')}</span>
                    </div>
                  </div>
                </div>
              </div>
            ))
          )}
        </div>
      ) : (
        <div className="bg-white p-5 rounded-2xl border border-slate-200 space-y-3">
          <h3 className="font-bold text-sm text-slate-900">Atur Ketersediaan Menu</h3>
          <div className="divide-y divide-slate-100">
            {menuItems.map((item) => (
              <div key={item.id} className="py-3 flex items-center justify-between">
                <div>
                  <p className="font-bold text-xs text-slate-800">{item.name}</p>
                  <p className="text-[10px] text-slate-400">{item.category}</p>
                </div>
                <button
                  onClick={() => onToggleStock(item.id)}
                  className={`px-3 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer ${
                    item.inStock 
                      ? 'bg-emerald-100 text-emerald-700 hover:bg-emerald-200' 
                      : 'bg-red-100 text-red-700 hover:bg-red-200'
                  }`}
                >
                  {item.inStock ? 'Tersedia' : 'Stok Habis'}
                </button>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

